// AeroOS 26R1 — riscv64 kernel entry point.
//
// Boot assembly (start.S) has set up stack and cleared BSS before
// calling us. We print a boot banner via NS16550 UART and halt.

extern "C" fn aeroos_uart_puts(msg: str);
extern "C" fn aeroos_uart_putc(c: i64);

#[entry]
#[no_mangle]
fn kernel_start() {
    aeroos_uart_puts("AeroOS 26R1 booting...\n");
    aeroos_uart_puts("OK\n");
    // On return, start.S halts the CPU (wfi loop).
}

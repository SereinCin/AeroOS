// AeroOS 26R1 — riscv64 kernel entry point.
//
// Boot assembly (start.S) has set up stack and cleared BSS.
// Trap handler and timer interrupt are wired in trap.S + clint.c
// but not yet enabled — MVP boot uses minimal setup.

extern "C" fn aeroos_uart_puts(msg: str);

#[entry]
#[no_mangle]
fn kernel_start() {
    aeroos_uart_puts("AeroOS 26R1 booting...\n");
    aeroos_uart_puts("OK\n");
    // On return, start.S halts the CPU (wfi loop).
}